{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "exactOptionalPropertyTypes": true,
    "allowJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] },
    "types": ["bun"]
  },
  "include": ["next-env.d.ts", "src", "next.config.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "out"]
}
