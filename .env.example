# Salin ke .env di root repo, lalu isi. .env tidak di-commit.
# apps/api membacanya lewat `bun --env-file=../../.env`.

# NetraRuntime (OpenAI-compatible, infra Indonesia). Wajib untuk /demo/chat.
NETRA_API_KEY=
NETRA_BASE_URL=https://api.netraruntime.com/v1
NETRA_MODEL=deepseek/deepseek-v4.1-flash

# Port HTTP apps/api. Web (Next.js) memakai 3000.
PORT=3001

# Origin web yang boleh memanggil API, dipisah koma.
WEB_ORIGINS=http://localhost:3000,https://thya.veterantech.id

# Postgres + pgvector. Lokal: `scripts/db-local.sh` menjalankan container thya-postgres
# (image sama dengan Dokploy dan CI, hanya di localhost). Login thya/thya khusus lokal.
# Produksi: Dokploy mengisi Internal Connection URL thya-db di env aplikasi, bukan file ini.
DATABASE_URL=postgres://thya:thya@localhost:5452/thya

# Tes integrasi (opsional lokal): database sekali pakai, jangan arahkan ke DATABASE_URL.
# RUN_INTEGRATION_TESTS=1
# TEST_DATABASE_URL=postgres://thya:thya@localhost:5452/thya_test

# WhatsApp Cloud API. Kanal WhatsApp hanya hidup kalau keempat nilai ini terisi.
# Webhook: https://<api>/webhook/whatsapp (GET verifikasi memakai WHATSAPP_VERIFY_TOKEN).
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v23.0

# Template utility yang sudah disetujui Meta, untuk kiriman di luar jendela 24 jam.
# WHATSAPP_RECAP_TEMPLATE=
# WHATSAPP_REMINDER_TEMPLATE=
# WHATSAPP_TEMPLATE_LANGUAGE=id

# Gerbang G11: baca screenshot QRIS/GoPay. Biarkan 0 sampai screenshot asli lulus S9-AC1.
# PAYMENTS_IMPORT_ENABLED=0
